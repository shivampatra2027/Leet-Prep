MONGODB_URI=
CORS_ORIGIN=https://leet-io-frontend.onrender.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
JWT_SECRET=supersecret

# Razorpay Configuration
# IMPORTANT: Get your keys from https://dashboard.razorpay.com/app/keys
# Click "Generate Test Keys" for testing or "Generate Live Keys" for production
# Test Mode Keys (for development - starts with rzp_test_)
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID_HERE
RAZORPAY_KEY_SECRET=YOUR_TEST_KEY_SECRET_HERE

# Webhook Secret (get from Razorpay Dashboard > Settings > Webhooks)
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# Live Mode Keys (for production - starts with rzp_live_)
# Uncomment these and replace test keys when going live
# RAZORPAY_KEY_ID=rzp_live_YOUR_LIVE_KEY_ID
# RAZORPAY_KEY_SECRET=YOUR_LIVE_KEY_SECRET

LEETCODE_API=https://leetcode.com/graphql

