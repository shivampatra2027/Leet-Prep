MONGODB_URI=

# Frontend URL (where your frontend is deployed)
# Local: http://localhost:5173
# Production options:
#   - https://www.leetcodepremium.xyz
#   - https://leet-io-frontend.onrender.com
#   - https://leet-prep.vercel.app
CLIENT_URL=https://www.leetcodepremium.xyz
CORS_ORIGIN=https://www.leetcodepremium.xyz

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Update this to your production backend URL for production
# Local: http://localhost:8080/auth/google/callback
# Production: https://leet-io-backend.onrender.com/auth/google/callback
GOOGLE_CALLBACK_URL=

JWT_SECRET=supersecret

# Razorpay Configuration
# Test Mode Keys (for development)
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_TEST_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# Live Mode Keys (for production - uncomment and replace test keys)
# RAZORPAY_KEY_ID=rzp_live_YOUR_LIVE_KEY_ID
# RAZORPAY_KEY_SECRET=YOUR_LIVE_KEY_SECRET

LEETCODE_API=https://leetcode.com/graphql

//sync2