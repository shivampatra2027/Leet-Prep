MONGODB_URI=

# Frontend URL (where your frontend is deployed)
# Local: http://localhost:5173
# Render: https://leet-io-frontend.onrender.com
# Vercel: https://www.leetcodepremium.xyz
CLIENT_URL=https://www.leetcodepremium.xyz

# CORS Origin (can be same as CLIENT_URL or specify alternative)
# For Vercel, support both www and non-www versions
CORS_ORIGIN=https://leetcodepremium.xyz

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Update this to match your backend deployment URL
# Local: http://localhost:8080/auth/google/callback
# Render: https://leet-io-backend.onrender.com/auth/google/callback
# Vercel: https://leet-io-back.vercel.app/auth/google/callback
GOOGLE_CALLBACK_URL=

JWT_SECRET=supersecret

# Razorpay Configuration
# Test Mode Keys (for development)
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_TEST_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# Live Mode Keys (for production - uncomment and replace test keys)
# RAZORPAY_KEY_ID=rzp_live_YOUR_LIVE_KEY_ID
# RAZORPAY_KEY_SECRET=YOUR_LIVE_KEY_SECRET

LEETCODE_API=https://leetcode.com/graphql

//sync2